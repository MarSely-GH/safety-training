<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Вахта — сколько придёт и когда</title>
<meta name="theme-color" content="#1B2A33">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Вахта">
<style>
:root{
  --bg:#D6DDE1; --card:#F1F4F6; --ink:#131C21; --soft:#5D6E77;
  --line:#AEBAC0; --hair:#C6CFD4; --blue:#1F5C7A;
  --day:#F0B85A; --dayInk:#3B2B09; --night:#1B2A33; --nightInk:#8FC6DC;
  --vac:#86A896; --vacInk:#12241A; --onrest:#B7C3C9;
  --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  padding:18px 14px 44px;-webkit-text-size-adjust:100%;-webkit-user-select:none;user-select:none}
input{-webkit-user-select:text;user-select:text}
.wrap{max-width:820px;margin:0 auto}
h1{margin:0;font-size:27px;font-weight:800;letter-spacing:-.02em;line-height:1.1}
.eyebrow{font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--blue);margin-bottom:4px}
.sub{margin-top:10px;font-family:var(--mono);font-size:12px;color:var(--soft)}
header{margin-bottom:18px}
.years{display:flex;gap:6px;margin-top:12px;flex-wrap:wrap}
.yr{background:transparent;border:1px solid var(--line);border-radius:2px;padding:6px 13px;
  font-size:13px;font-weight:700;font-family:var(--mono);color:var(--soft)}
.yr.on{background:var(--blue);border-color:var(--blue);color:#fff}
section{background:var(--card);border:1px solid var(--line);border-radius:3px;padding:16px;margin-bottom:14px}
.shead{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:14px}
h2{margin:0;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--blue);font-weight:700}
.shead .meta{font-family:var(--mono);font-size:12px;color:var(--soft);text-align:right}
label.f{display:block}
label.f>span{display:block;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--soft);margin-bottom:5px}
label.f>small{display:block;font-size:11px;color:var(--soft);margin-top:4px}
input[type=number],input[type=date]{width:100%;background:#fff;border:1px solid var(--line);border-radius:2px;
  padding:9px 10px;font-size:15px;color:var(--ink);font-family:var(--mono);outline:none}
input:focus-visible,button:focus-visible{outline:2px solid var(--blue);outline-offset:2px}
button{cursor:pointer;font-family:inherit}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.gridA{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.chips{display:flex;flex-wrap:wrap;gap:7px;margin:10px 0 16px}
.chip{background:transparent;border:1px solid var(--line);border-radius:2px;padding:7px 11px;font-size:12px;color:var(--blue)}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px}
.card{border-radius:2px;padding:13px 14px}
.card.dark{background:var(--night);color:#fff}
.card.lite{background:#fff;border:1px solid var(--line)}
.card .lab{font-size:11px;letter-spacing:.08em;text-transform:uppercase}
.card.dark .lab,.card.dark .note{color:var(--nightInk)}
.card.lite .lab,.card.lite .note{color:var(--soft)}
.card .big{font-family:var(--mono);font-size:24px;font-weight:800;margin-top:5px}
.card .note{font-size:11px;margin-top:2px}
.stats{display:flex;flex-wrap:wrap;gap:14px;margin-top:12px;font-size:12px;color:var(--soft);font-family:var(--mono)}
.nav{display:flex;align-items:center;gap:8px}
.nav button{background:#fff;border:1px solid var(--line);border-radius:2px;color:var(--blue);
  font-size:16px;font-weight:700;padding:3px 11px;line-height:1.3}
.brush{display:flex;flex-wrap:wrap;gap:5px;padding:10px;background:#fff;border:1px solid var(--line);
  border-radius:2px;margin-bottom:14px}
.br{border-radius:2px;padding:8px 12px;font-size:13px;font-weight:700;font-family:var(--mono);border:1px solid transparent;opacity:.5}
.br.on{opacity:1;box-shadow:0 0 0 2px var(--blue)}
.mblock{margin-bottom:14px}
.mtitle{display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin-bottom:6px;
  padding-bottom:4px;border-bottom:1px solid var(--hair);cursor:pointer}
.mtitle .nm{font-size:13px;font-weight:700}
.mtitle .st{font-family:var(--mono);font-size:11px;color:var(--soft)}
.mtitle.on .nm{color:var(--blue)}
.days{display:grid;grid-template-columns:repeat(auto-fill,minmax(38px,1fr));gap:3px;touch-action:auto}
.days.dragon{touch-action:none}
.tgl{border-radius:2px;padding:8px 12px;font-size:12px;font-weight:700;border:1px solid var(--line);background:#fff;color:var(--blue)}
.tgl.on{background:var(--blue);color:#fff;border-color:var(--blue)}
.okl input{font-size:19px;font-weight:800;padding:12px}
.cell{border-radius:2px;padding:4px 2px 5px;display:flex;flex-direction:column;align-items:center;gap:1px;border:1px solid transparent}
.cell .n{font-size:9px;opacity:.65;font-family:var(--mono)}
.cell .c{font-size:12px;font-weight:700;font-family:var(--mono)}
.k-rest{background:#C9D2D6;color:#5A6A72;border-color:var(--hair)}
.k-onrest{background:var(--onrest);color:#3E4E55;border-color:var(--line)}
.k-day{background:var(--day);color:var(--dayInk);border-color:#D9A247}
.k-night{background:var(--night);color:var(--nightInk);border-color:var(--night)}
.k-move{background:#fff;color:var(--blue);border:1px dashed var(--blue)}
.k-vac{background:var(--vac);color:var(--vacInk);border-color:#6E9280}
.pay{display:flex;gap:11px;align-items:center;padding:11px 0;border-bottom:1px solid var(--hair)}
.pay .when{font-family:var(--mono);font-size:13px;font-weight:700;color:var(--blue);width:84px;flex-shrink:0}
.pay .what{flex:1;min-width:0;font-size:13px;line-height:1.35}
.pay .what small{display:block;color:var(--soft);font-size:11px}
.pay .sum{font-family:var(--mono);font-size:17px;font-weight:800;white-space:nowrap;text-align:right}
.pay .sum small{display:block;font-weight:400;font-size:10px;color:var(--soft)}
table{width:100%;border-collapse:collapse;font-size:12px;font-family:var(--mono)}
th{color:var(--soft);font-weight:600;padding:4px 6px;text-align:right}
th.l,td.l{text-align:left}
td{padding:7px 6px;text-align:right}
tbody tr.click{cursor:pointer;border-top:1px solid var(--hair)}
tbody tr.on{background:#fff}
td.mon{color:var(--blue);font-weight:700}
td.b{font-weight:700}
td.s{color:var(--soft)}
.line{display:flex;gap:8px;padding:5px 0;border-bottom:1px solid var(--hair);font-size:13px}
.line .code{font-family:var(--mono);font-size:11px;color:var(--blue);width:34px;flex-shrink:0}
.line .nm{flex:1;min-width:0}
.line .qt{font-family:var(--mono);font-size:11px;color:var(--soft)}
.tot{display:flex;justify-content:space-between;padding:8px 0;border-top:1px solid var(--hair);font-weight:700}
.tot .v{font-family:var(--mono);font-size:16px}
.big-out{display:flex;justify-content:space-between;align-items:baseline;margin-top:10px;padding:13px 14px;border-radius:2px}
.big-out .lab{font-size:12px;letter-spacing:.1em;text-transform:uppercase}
.big-out .v{font-family:var(--mono);font-size:25px;font-weight:800}
.out-dark{background:var(--night);color:#fff}.out-dark .lab{color:var(--nightInk)}
.out-vac{background:var(--vac);color:var(--vacInk)}
p.note{font-size:11px;color:var(--soft);margin:9px 0 0;line-height:1.45}
.pbtns{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.pbtn{background:transparent;color:var(--blue);border:1px solid var(--line);border-radius:3px;padding:11px 6px;
  font-size:11px;letter-spacing:.06em;text-transform:uppercase;font-weight:700}
.pbtn.on{background:var(--blue);color:#fff;border-color:var(--blue)}
.panel{background:var(--card);border:1px solid var(--line);border-radius:3px;padding:16px;margin-top:8px}
.panel table td{padding:3px;text-align:left}
.spread,.mini{border:1px soli