></table></div><p class="note">Столбец \u00AB14-го\u00BB \u2014 остаток за тот же месяц, приходит он в следующем. Декабрьский \u2014 14 января. Если смены были только во второй половине месяца, аванс 29-го выходит нулевой, и всё придёт одной суммой 14-го.</p></section>');

 /* ── отпуск ── */
 var runsAll=calcYear(S.cur).vacRuns||[];
 var vacDaysAll=runsAll.reduce(function(a,r){return a+r.len;},0);
 H.push('<section><div class="shead"><h2>Отпускные</h2><div class="meta">'+
  (vacDaysAll?vacDaysAll+' дн отмечено в графике':'отпуск в графике не отмечен')+'</div></div><div class="gridA">'+
  '<label class="f"><span>Среднедневной, \u20BD</span><input type="number" data-set="vacAvg" value="'+S.vac.avg+'">'+
   '<small>из расчётки: строки отпуска \u00F7 дни. У вас в мае вышло 8 591</small></label>'+
  '<label class="f"><span>Единовременная выплата, \u20BD</span><input type="number" data-set="vacBonus" value="'+S.vac.bonus+'">'+
   '<small>добавляется к первому отпуску в году</small></label></div>');
 if(runsAll.length){
  H.push('<div style="margin-top:12px">');
  runsAll.forEach(function(r){
   H.push('<div class="pay"><span class="when">'+r.payD+' '+MSHORT[r.payM]+'</span>'+
    '<span class="what">Отпуск с '+r.d0+' '+MGEN[r.m0]+', '+r.len+' дн'+
    '<small>выплата за три дня до начала</small></span>'+
    '<span class="sum">'+rub(r.gross*netK)+'<small>начислено '+rub(r.gross)+'</small></span></div>');});
  H.push('</div>');
 } else H.push('<p class="note">Закрасьте дни отпуска кодом \u00ABO\u00BB в графике — отпускные посчитаются сами и встанут в список выплат.</p>');
 H.push('</section>');

 /* ── панели ── */
 H.push('<div class="pbtns">'+
  '<button class="pbtn'+(S.panel==="oklad"?" on":"")+'" data-act="panel" data-k="oklad">Оклады и доплаты</button>'+
  '<button class="pbtn'+(S.panel==="rates"?" on":"")+'" data-act="panel" data-k="rates">Проценты и ставки</button>'+
  '<button class="pbtn" data-act="clear">Очистить '+S.cur+' год</button>'+
  '<button class="pbtn" data-act="reset">Сбросить настройки</button></div>');
 if(S.panel==="oklad"){
  var yr=Yr(S.cur);
  H.push('<div class="panel"><div class="gridA" style="margin-bottom:16px">'+
   '<label class="f"><span>Норма, ч/мес</span><input type="number" step="0.01" data-set="norma" value="'+S.norma+'"><small>строка ПланГПК</small></label>'+
   '<label class="f"><span>Надбавка за личный вклад, %</span><input type="number" data-set="lich" value="'+S.lich+'"><small>строка 2061, с октября 2025 не начисляется</small></label>'+
   '</div><table><thead><tr><th class="l">Мес</th><th class="l">Оклад</th><th class="l">Прочие начисления</th><th class="l">Путь \u20BD/дн</th><th></th></tr></thead><tbody>');
  MONTHS.forEach(function(mn,i){
   H.push('<tr><td class="l mon">'+MSHORT[i]+'</td>'+
    '<td><input type="number" data-set="oklad" data-i="'+i+'" value="'+yr.oklads[i]+'"></td>'+
    '<td><input type="number" data-set="extra" data-i="'+i+'" value="'+yr.extras[i]+'"></td>'+
    '<td><input type="number" data-set="travel" data-i="'+i+'" value="'+yr.travels[i]+'"></td>'+
    '<td><button class="spread" data-act="spread" data-i="'+i+'">\u2193</button></td></tr>');});
  H.push('</tbody></table><p class="note">\u00ABПрочие начисления\u00BB \u2014 годовое вознаграждение, премии к праздничным датам, '+
   'отпускные и единовременные выплаты. Стрелка копирует оклад во все месяцы ниже. У каждого года свои оклады.</p></div>');
 }
 if(S.panel==="rates"){
  H.push('<div class="panel"><div class="gridA">');
  [["rk","Райкоэффициент, %"],["sn","Севнадбавка, %"],["prem","Премия, %"],["night","Доплата за ночь, %"],
   ["vahtaDay","Вахтовая надбавка, \u20BD/дн"],["prof","Профвзнос, %"],["ndfl1","НДФЛ базовый, %"],
   ["ndfl2","НДФЛ сверх порога, %"],["limMain","Порог основной базы, \u20BD"],["limRksn","Порог базы РК+СН, \u20BD"],
   ["avansK","Коэффициент аванса"]].forEach(function(r){
   H.push('<label class="f"><span>'+r[1]+'</span><input type="number" step="0.01" data-set="p" data-k="'+r[0]+'" value="'+p[r[0]]+'"></label>');});
  H.push('</div><p class="note">Ставки общие для всех годов. Коэффициент аванса откалиброван по расчёткам за январь и февраль 2026, июль и сентябрь 2025.</p></div>');
 }
 document.getElementById("app").innerHTML=H.join("");
}

/* ── заливка ── */
var painting=false,pStart=null,undo=[];
function paint(el){
 if(!el)return;
 var y=+el.getAttribute("data-y"),m=+el.getAttribute("data-m"),d=+el.getAttribute("data-d");
 if(isNaN(y)||isNaN(m)||isNaN(d))return;
 var yr=Yr(y);
 if(yr.grids[m][d-1]===S.brush)return;
 undo.push({y:y,m:m,d:d,prev:yr.grids[m][d-1]});
 if(undo.length>300)undo.shift();
 yr.grids[m][d-1]=S.brush; save(); render();
}
document.addEventListener("pointerdown",function(e){
 var el=e.target.closest("[data-paint]");
 if(!el){pStart=null;return;}
 pStart={el:el,x:e.clientX,y:e.clientY,moved:false};
 if(S.drag){e.preventDefault();painting=true;paint(el);}
});
document.addEventListener("pointermove",function(e){
 if(pStart&&!pStart.moved&&
    (Math.abs(e.clientX-pStart.x)>8||Math.abs(e.clientY-pStart.y)>8))pStart.moved=true;
 if(!painting||!S.drag)return;
 var el=document.elementFromPoint(e.clientX,e.clientY);
 if(el&&el.closest)paint(el.closest("[data-paint]"));
});
document.addEventListener("pointerup",function(){
 if(!S.drag&&pStart&&!pStart.moved)paint(pStart.el);
 painting=false;pStart=null;
});
document.addEventListener("pointercancel",function(){painting=false;pStart=null;});

function vahtaRange(dir){
 var flat=[];
 allMonths().forEach(function(mm){mm.days.forEach(function(x){
  flat.push({key:iso(mm.y,mm.m,x.d),on:!!CODES[x.code].on});});});
 flat.sort(function(a,b){return a.key<b.key?-1:1;});
 var today=new Date().toISOString().slice(0,10);
 var i=flat.findIndex(function(f){return f.key>=today;});
 if(i<0)i=0;
 if(dir==="next"){while(i<flat.length&&!flat[i].on)i++;}
 else{while(i>0&&flat[i].on)i--; if(!flat[i].on)i++;
      while(i<flat.length&&!flat[i].on)i++;}
 if(i>=flat.length||!flat[i].on)return;
 var a=i,b=i;
 while(a>0&&flat[a-1].on)a--;
 while(b<flat.length-1&&flat[b+1].on)b++;
 S.from=flat[a].key; S.to=flat[b].key;
}
document.addEventListener("click",function(e){
 var el=e.target.closest("[data-act]"); if(!el)return;
 var a=el.getAttribute("data-act");
 if(a==="brush")S.brush=el.getAttribute("data-code");
 else if(a==="dragtog")S.drag=!S.drag;
 else if(a==="undo"){var u=undo.pop(); if(u)Yr(u.y).grids[u.m][u.d-1]=u.prev;}
 else if(a==="shift"){S.start+=(+el.getAttribute("data-n"));
  while(S.start<0){S.start+=12;S.cur--;}
  while(S.start>11){S.start-=12;S.cur++;}
  Yr(S.cur);}
 else if(a==="selm"){S.sel=+el.getAttribute("data-m");S.selY=+el.getAttribute("data-y");}
 else if(a==="selshift"){S.sel+=(+el.getAttribute("data-n"));
  if(S.sel<0){S.sel=11;S.selY=(S.selY||S.cur)-1;}
  if(S.sel>11){S.sel=0;S.selY=(S.selY||S.cur)+1;}
  Yr(S.selY||S.cur);}
 else if(a==="jump"){S.sel=+el.getAttribute("data-m");S.selY=S.cur;
  S.start=Math.max(0,Math.min(9,S.sel-1));}
 else if(a==="year"){S.cur=+el.getAttribute("data-y");Yr(S.cur);S.start=0;S.sel=0;S.selY=S.cur;
  S.from=iso(S.cur,0,1);S.to=iso(S.cur,11,31);}
 else if(a==="panel"){var k=el.getAttribute("data-k");S.panel=(S.panel===k?"":k);}
 else if(a==="spread"){var i=+el.getAttribute("data-i"),yr=Yr(S.cur);
  for(var j=i+1;j<12;j++)yr.oklads[j]=yr.oklads[i];}
 else if(a==="q"){var q=el.getAttribute("data-q");
  if(q==="year"){S.from=iso(S.cur,0,1);S.to=iso(S.cur,11,31);}
  else if(q==="win"){var w0=mAt(0),w2=mAt(2);
   S.from=iso(w0.y,w0.m,1);S.to=iso(w2.y,w2.m,dim(w2.y,w2.m));}
  else vahtaRange(q);}
 else if(a==="clear"){if(confirm("Очистить весь график "+S.cur+" года? Все дни станут \u00ABВ\u00BB."))
  Yr(S.cur).grids=blankGrids();}
 else if(a==="reset"){if(confirm("Вернуть всё к исходному состоянию?"))S=defState();}
 save(); render();
});
document.addEventListener("change",function(e){
 var el=e.target,key=el.getAttribute("data-set"); if(!key)return;
 var yr=Yr(S.cur);
 var v=el.type==="checkbox"?el.checked:(el.type==="number"?